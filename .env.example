# Environment Setup
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# App Modes
# Use 'api' to connect to Postgres, or 'mock' to use in-memory frontend mock
DATA_MODE=api
# Use 'mock', 'manual', or standard payment gateway integrations when available
PAYMENT_MODE=manual
ENABLE_DEV_QA_PANEL=false

# URLs
APP_PUBLIC_URL=http://localhost:3000

# Security (MUST BE CHANGED IN PRODUCTION)
JWT_SECRET=super_secret_key_change_me
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# Database
# Used by Prisma to connect to the PostgreSQL database.
DATABASE_URL="postgresql://cofcof:cofcof_pwd@localhost:5432/cofcof_db?schema=public"
